Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' https://wow.zamimg.com https://static-cdn.jtvnw.net data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'sha256-jFBL5JrBkR58wno+Ew+KEoONtEkcP9wjpgE7IX6cMjQ='; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'"
  Header always set X-Robots-Tag "noai, noimageai"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_URI} !^/robots\.txt$
  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|Claude-SearchBot|Claude-Web|anthropic-ai|CCBot|PerplexityBot|Perplexity-User|Bytespider|Amazonbot|meta-externalagent|meta-externalfetcher|FacebookBot|cohere-ai|cohere-training-data-crawler|MistralAI-User|DuckAssistBot|YouBot|AI2Bot|Ai2Bot-Dolma|Diffbot|ImagesiftBot|Omgilibot|Omgili|Timpibot|PanguBot|Kangaroo\ Bot|iaskspider|ICC-Crawler|VelenPublicWebCrawler|Webzio-Extended|FirecrawlAgent|TikTokSpider|img2dataset|Scrapy|SemrushBot-OCOB|Brightbot|QualifiedBot|Novellum|Andibot|PhindBot|wpbot|Crawlspace|Factset_spyderbot|TurnitinBot|NovaAct) [NC]
  RewriteRule ^ - [F,L]

  RewriteRule ^api/(data(/|$)|_lib\.php$) - [F,L]

  RewriteRule ^(tools|node_modules|docs|packages)(/|$) - [F,L,NC]
  RewriteRule ^package(-lock)?\.json$ - [F,L]

  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{THE_REQUEST} \s/+index\.html(\?[^\s]*)?\s [NC]
  RewriteRule ^index\.html$ /%1 [R=301,L]

  RewriteRule ^a-propos\.html$ https://azerothforever.info/ [R=301,L]
  RewriteRule ^arbre-historique\.html$ https://azerothforever.info/arbre-heritage [R=301,L]
  RewriteRule ^systeme-heritage(\.html)?$ https://azerothforever.info/arbre-heritage [R=301,L]
  RewriteRule ^grimoire\.html$ https://azerothforever.info/competences [R=301,L]

  RewriteRule ^b/([A-Za-z0-9]{8})/?$ api/go.php?id=$1 [L]

  # Anciennes pages par instance (Phase 4, v1) : une seule page publique, /donjons, qui ouvre la fiche.
  RewriteRule ^donjons-([a-z0-9-]+?)(?:\.html)?/?$ https://azerothforever.info/donjons?ouvrir=$1 [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+)\.html(\?[^\s]*)?\s [NC]
  RewriteRule ^ /%1%2 [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [NC,L]
</IfModule>
